# Application
PROJECT_NAME=SoloBuildAI
ENVIRONMENT=development
DEBUG=False
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_DB=solobuildai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-your-database-password@localhost:5432/solobuildai

# AWS S3
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# AI
AI_EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
GEMINI_EXTRACTION_MODEL=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_SUMMARY_MODEL=gemini-2.0-flash-lite
LLM_REQUEST_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=2.0
WORKER_MAX_TRIES=3
ARQ_JOB_TIMEOUT_SECONDS=1800

# Redis
REDIS_URL=redis://localhost:6379

# Telephony and real-time voice
TELEPHONY_CARRIER=vobiz
APP_BASE_URL=http://localhost:8000
VOBIZ_API_BASE_URL=https://api.vobiz.ai/api/v1
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_PHONE_NUMBER=
VOBIZ_ANSWER_PATH=/api/v1/telephony/vobiz/answer
VOBIZ_RECORDING_PATH=/api/v1/telephony/vobiz/recording-ready
VOBIZ_MEDIA_PATH=/api/v1/telephony/vobiz/media
VOBIZ_REQUEST_TIMEOUT_SECONDS=15.0
TELEPHONY_WEBHOOK_SECRET=
TELEPHONY_WEBHOOK_HEADER=X-Telephony-Signature
VOBIZ_WEBHOOK_SECRET=
PIPECAT_VOICE_PROVIDER=gemini_live
PIPECAT_GEMINI_API_KEY=
PIPECAT_GEMINI_LIVE_MODEL=models/gemini-2.5-flash-native-audio-preview-12-2025
PIPECAT_GEMINI_LIVE_VOICE=Charon
PIPECAT_GEMINI_LIVE_LANGUAGE=en-US

# Resume and CSV pipeline
CSV_CHUNK_SIZE=50
RESUME_MAX_FILE_COUNT=500
ZIP_MAX_UNCOMPRESSED_BYTES=524288000
ZIP_MAX_RATIO=50
